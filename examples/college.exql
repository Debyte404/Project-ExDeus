-- ExdeusQL college database: students, courses, and enrollments.
-- Run it with:  Get-Content examples/college.exql | .\build\Debug\exdeus.exe

create db college;
harness college;

forge table students with
  id: integer unique,
  name: text,
  year: integer,
  active: boolean;

add students (1, "Asha", 2, true);
add students (2, "Ravi", 3, true);
add students (3, "Mira", 1, false);

forge table courses with
  id: integer unique,
  title: text,
  credits: integer;

add courses (201, "Databases", 4);
add courses (202, "Compilers", 3);
add courses (203, "Linear Algebra", 4);

forge table enrollments with
  id: integer unique,
  student_id: integer,
  course_id: integer,
  grade: decimal;

add enrollments (3001, 1, 201, 9.20);
add enrollments (3002, 1, 203, 8.75);
add enrollments (3003, 2, 201, 7.50);
add enrollments (3004, 2, 202, 8.10);
add enrollments (3005, 3, 203, 6.40);

-- Active students, newest intake first.
seek students show name, year where active equals true order by year descending;

-- Grade bump: every Databases grade grows by 0.25.
change enrollments
  set grade to grade plus 0.25
  where course_id equals 201;

-- Withdraw Mira's enrollments, then show the register.
remove enrollments where student_id equals 3;
seek enrollments show student_id, course_id, grade order by grade descending;

save db to "college.exd";
export enrollments to "enrollments.csv";
